          "stringUnit" : {
            "state" : "translated",
            "value" : "Dismiss notice"
          }
        }
      }
    },
    "Zpráva neodešla — nic se nestrhlo. Zkuste to prosím znovu, až budete mít signál." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The message didn't go out — nothing was charged. Please try again once you have a signal."
